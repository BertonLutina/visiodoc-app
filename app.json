{
  "expo": {
    "name": "VisioDoc",
    "slug": "visiodoc-app",
    "version": "1.0.0",
    "scheme": "visiodoc",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visiodoc.app",
      "infoPlist": {
        "NSCameraUsageDescription": "VisioDoc utilise la caméra pour les consultations vidéo.",
        "NSMicrophoneUsageDescription": "VisioDoc utilise le micro pour les consultations vidéo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.visiodoc.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "VisioDoc utilise Face ID pour sécuriser l'accès à votre dossier médical."
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F6E56"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a67496a9-353a-4daf-88a9-e21c458266e1"
      }
    },
    "owner": "creaafde",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a67496a9-353a-4daf-88a9-e21c458266e1"
    }
  }
}
